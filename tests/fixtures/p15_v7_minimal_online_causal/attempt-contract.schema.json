{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p15-v7-minimal-online-causal-attempt-v7",
  "type": "object",
  "required": [
    "schema_version",
    "attempt_id",
    "execution_role",
    "status",
    "execution_eligible",
    "user_approval_required",
    "approval_receipt",
    "approval_rule",
    "contract_frozen_at_utc",
    "contract_binding",
    "catalog_contract",
    "offline_catalog_source",
    "catalog_ordering",
    "exclusion_projection",
    "eligibility",
    "allowlist_rule",
    "execution_rule",
    "catalog_receipt",
    "future_allowlist",
    "corpus",
    "sampling",
    "zero_state"
  ],
  "properties": {
    "schema_version": {"const": "p15-v7-minimal-online-causal-attempt-v7"},
    "attempt_id": {"const": "p15-v7-attempt-007"},
    "execution_role": {"const": "two_repository_acceptance_draft"},
    "status": {"const": "DRAFT"},
    "execution_eligible": {"const": false},
    "user_approval_required": {"const": true},
    "approval_receipt": {"$ref": "#/$defs/emptyReceipt"},
    "approval_rule": {
      "const": {
        "scope": "single_receipt_authorizes_two_refs_then_source_then_fresh_then_if_fresh_passes_heldout_and_release",
        "reapproval_triggers": ["plan_field_change", "threshold_change", "query_change", "model_change", "case_rule_change"]
      }
    },
    "contract_frozen_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "contract_binding": {
      "type": "object",
      "required": ["projection_algorithm", "projection_sha256"],
      "properties": {
        "projection_algorithm": {
          "const": "sha256_of_canonical_contract_with_empty_catalog_allowlist_and_approval_receipts"
        },
        "projection_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "catalog_contract": {
      "type": "object",
      "required": [
        "provider",
        "transport",
        "api_version",
        "window_derivation",
        "window_duration",
        "window_start_utc",
        "window_end_utc",
        "prior_universe_exclusion",
        "search_endpoint",
        "q",
        "sort",
        "order",
        "per_page",
        "max_total_count",
        "required_full_passes",
        "catalog_integrity_rule",
        "page_receipt_etag_rule",
        "catalog_receipt_rule",
        "max_server_date_lag_seconds",
        "page_attempts",
        "request_headers",
        "ref_resolution_protocol",
        "resolution_receipt_rule",
        "failure_policy"
      ],
      "properties": {
        "provider": {"const": "github"},
        "transport": {"const": "GitHub REST"},
        "api_version": {"const": "2022-11-28"},
        "window_derivation": {
          "const": "window_start=floor_utc_hour(contract_frozen_at_utc)-P28D;duration=PT5M;window_end=window_start+PT5M-PT1S"
        },
        "window_duration": {"const": "PT5M"},
        "window_start_utc": {"type": "string"},
        "window_end_utc": {"type": "string"},
        "prior_universe_exclusion": {
          "const": {
            "rule": "closed_interval_disjoint_from_attempt_005_catalog_window",
            "attempt_id": "p15-v7-attempt-005",
            "window_start_utc": "2026-07-04T06:00:00Z",
            "window_end_utc": "2026-07-04T06:04:59Z"
          }
        },
        "search_endpoint": {"const": "https://api.github.com/search/repositories"},
        "q": {"type": "string"},
        "sort": {"const": "updated"},
        "order": {"const": "asc"},
        "per_page": {"const": 100},
        "max_total_count": {"const": 1000},
        "required_full_passes": {"const": 2},
        "catalog_integrity_rule": {
          "const": "two_full_passes_exact_total_and_canonical_body_projection"
        },
        "page_receipt_etag_rule": {
          "const": "hash_bound_nullable_observation_not_integrity_evidence"
        },
        "catalog_receipt_rule": {
          "const": "append_only_full_ordered_catalog_and_page_evidence_sealed_before_refs"
        },
        "max_server_date_lag_seconds": {"const": 5},
        "page_attempts": {"const": 1},
        "request_headers": {
          "const": {
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28"
          }
        },
        "ref_resolution_protocol": {
          "const": {
            "protocol": "git_ls_remote_https_identity_only_v1",
            "argv_template": ["git", "-c", "credential.helper=", "ls-remote", "--refs", "https://github.com/{owner}/{repository}.git", "refs/heads/{default_branch_literal}"],
            "default_branch_encoding": "literal_separate_argv_no_url_encoding",
            "environment": {"GIT_TERMINAL_PROMPT": "0", "GIT_CONFIG_NOSYSTEM": "1", "GIT_CONFIG_GLOBAL": "/dev/null", "LC_ALL": "C"},
            "timeout_seconds": 30,
            "attempts_per_repository": 3,
            "backoff_schedule_seconds": [0, 2, 5],
            "checkout_allowed": false,
            "repository_failure_policy": "retry_same_selected_repository_then_inconclusive",
            "global_failure_policy": "stop_inconclusive_no_fallback_beyond_canonical_prefix2",
            "order": "sealed_catalog_canonical_prefix2"
          }
        },
        "resolution_receipt_rule": {
          "const": "append_only_all_attempts_for_canonical_prefix2_only"
        },
        "failure_policy": {
          "const": "resolution_exhaustion_inconclusive_no_third_repository_or_substitution"
        }
      },
      "additionalProperties": false
    },
    "offline_catalog_source": {
      "type": "object",
      "required": ["mode", "attempt_id", "archived_contract_path", "archived_contract_sha256", "archived_contract_projection_sha256", "audit_path", "audit_sha256", "capture_path", "capture_sha256", "capture_projection_sha256", "catalog_requests_exact"],
      "properties": {
        "mode": {"const": "immutable_attempt_006_capture_no_requery"},
        "attempt_id": {"const": "p15-v7-attempt-006"},
        "archived_contract_path": {"const": "audit/p15-v7-attempt-006-contract.json"},
        "archived_contract_sha256": {"$ref": "#/$defs/sha256"},
        "archived_contract_projection_sha256": {"$ref": "#/$defs/sha256"},
        "audit_path": {"const": "audit/attempt-006-catalog-validation-failure-audit.json"},
        "audit_sha256": {"$ref": "#/$defs/sha256"},
        "capture_path": {"const": "audit/attempt-006-catalog-validation-failure-capture.json"},
        "capture_sha256": {"$ref": "#/$defs/sha256"},
        "capture_projection_sha256": {"$ref": "#/$defs/sha256"},
        "catalog_requests_exact": {"const": 0}
      },
      "additionalProperties": false
    },
    "catalog_ordering": {
      "const": {
        "pre_ref": {
          "tuple": ["NFKC(provider).casefold()", "NFKC(owner).casefold()", "NFKC(repository).casefold()"],
          "order": "unicode_lex_ascending",
          "tie_policy": "duplicate_normalized_repository_fail_no_input_or_api_tie"
        },
        "post_ref": {
          "tuple": ["NFKC(provider).casefold()", "NFKC(owner).casefold()", "NFKC(repository).casefold()", "immutable_revision.lower()", "identity_sha256.lower()"],
          "identity_fields": ["provider", "owner", "repository", "default_branch", "immutable_revision"],
          "identity_sha256_algorithm": "sha256_of_canonical_json_identity_sort_keys_compact_ascii",
          "order": "unicode_lex_ascending",
          "tie_policy": "duplicate_repository_or_tuple_fail"
        },
        "updated_at_role": "evidence_only_forbidden_from_eligibility_and_sort"
      }
    },
    "exclusion_projection": {
      "type": "object",
      "required": [
        "normalization",
        "canonical_repositories",
        "count",
        "canonical_repository_list_algorithm",
        "canonical_repository_list_sha256",
        "projection_algorithm",
        "projection_sha256",
        "source_audits"
      ],
      "properties": {
        "normalization": {
          "const": "provider_owner_repository_unicode_nfkc_casefold"
        },
        "canonical_repositories": {
          "type": "array",
          "minItems": 21,
          "maxItems": 21,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "count": {"const": 21},
        "canonical_repository_list_algorithm": {
          "const": "sha256_of_canonical_json_canonical_repositories_array_sort_keys_compact_ascii"
        },
        "canonical_repository_list_sha256": {"$ref": "#/$defs/sha256"},
        "projection_algorithm": {
          "const": "sha256_of_canonical_json_normalization_canonical_repositories_count_sort_keys_compact_ascii"
        },
        "projection_sha256": {"$ref": "#/$defs/sha256"},
        "source_audits": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["attempt_id", "path", "sha256", "audit_only_hashes"],
            "properties": {
              "attempt_id": {"enum": ["p15-v7-attempt-001", "p15-v7-attempt-002", "p15-v7-attempt-003", "p15-v7-attempt-004", "p15-v7-attempt-005", "p15-v7-attempt-006"]},
              "path": {"type": "string"},
              "sha256": {"$ref": "#/$defs/sha256"},
              "audit_only_hashes": {"const": true}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "eligibility": {
      "const": {
        "only": [
          "public",
          "language_python",
          "default_branch_commit_resolved",
          "not_excluded"
        ]
      }
    },
    "allowlist_rule": {
      "const": {
        "contents": "resolved_eligible_canonical_prefix2_only",
        "order": "frozen_post_ref_five_tuple_ascending"
      }
    },
    "execution_rule": {
      "const": {
        "repository_count": 2,
        "selection": "canonical_catalog_prefix2",
        "distinct_canonical_repositories": true,
        "fallback_beyond_prefix_forbidden": true,
        "resolution_attempts_per_repository": 3,
        "resolution_timeout_seconds": 30,
        "resolution_backoff_seconds": [0, 2, 5],
        "resolution_exhaustion_disposition": "INCONCLUSIVE"
      }
    },
    "catalog_receipt": {"$ref": "#/$defs/sealedReceipt"},
    "future_allowlist": {
      "type": "object",
      "required": ["received", "path", "sha256", "identity_selected"],
      "properties": {
        "received": {"const": false},
        "path": {"const": ""},
        "sha256": {"const": ""},
        "identity_selected": {"const": false}
      },
      "additionalProperties": false
    },
    "corpus": {
      "type": "object",
      "required": ["fresh_repositories", "fresh_cases", "fixed_denominators", "per_repository", "selection_contract"],
      "properties": {
        "fresh_repositories": {"type": "array", "maxItems": 0},
        "fresh_cases": {"type": "array", "maxItems": 0},
        "fixed_denominators": {
          "const": {
            "repositories": 2,
            "cases": 12,
            "efficacy_targets": 8,
            "guard_cases": 4,
            "planner_samples": 24,
            "local_arm_replays": 96
          }
        },
        "per_repository": {
          "const": {"efficacy_cases": 4, "guard_cases": 2}
        },
        "selection_contract": {
          "const": {
            "stage": "before_any_online_request",
            "repository_order": "resolved_canonical_prefix2",
            "structural_order": "frozen_independent_ast_order",
            "per_repository_indices": [1, 2, 3, 4, 5, 6],
            "guard_indices": [1, 2],
            "efficacy_candidate_indices": [3, 4, 5, 6],
            "cases_per_repository": 6,
            "repository_count": 2,
            "total_cases": 12,
            "scan_beyond_index_6_allowed": false,
            "case_replacement_allowed": false,
            "repository_replacement_allowed": false,
            "qualification_online_requests": 0,
            "efficacy_control_requirement": "gold_missing_in_both_complete_frozen_samples_else_INCONCLUSIVE_CORPUS"
          }
        }
      },
      "additionalProperties": true
    },
    "sampling": {
      "type": "object",
      "required": ["expanded_schedule"],
      "properties": {
        "expanded_schedule": {"type": "array", "maxItems": 0}
      },
      "additionalProperties": true
    },
    "zero_state": {"$ref": "#/$defs/zeroState"}
  },
  "additionalProperties": true,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "emptyReceipt": {
      "type": "object",
      "required": ["received", "path", "sha256"],
      "properties": {
        "received": {"const": false},
        "path": {"const": ""},
        "sha256": {"const": ""}
      },
      "additionalProperties": false
    },
    "sealedReceipt": {
      "type": "object",
      "required": ["received", "path", "sha256"],
      "properties": {
        "received": {"const": true},
        "path": {"const": "attempt-007-sealed-catalog-receipt.json"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "zeroState": {
      "type": "object",
      "required": [
        "catalog_requests",
        "ref_requests",
        "source_accesses",
        "planner_calls",
        "embedding_calls",
        "control_executions",
        "treatment_executions",
        "effect_observations",
        "online_model_calls",
        "ollama_calls",
        "held_out_accesses"
      ],
      "properties": {
        "catalog_requests": {"const": 0},
        "ref_requests": {"const": 0},
        "source_accesses": {"const": 0},
        "planner_calls": {"const": 0},
        "embedding_calls": {"const": 0},
        "control_executions": {"const": 0},
        "treatment_executions": {"const": 0},
        "effect_observations": {"const": 0},
        "online_model_calls": {"const": 0},
        "ollama_calls": {"const": 0},
        "held_out_accesses": {"const": 0}
      },
      "additionalProperties": false
    }
  }
}
