  "$defs": {
    "pathDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "files",
        "sha256"
      ],
      "properties": {
        "name": {
          "enum": [
            "product",
            "behavior_tests",
            "runner",
            "config_docs",
            "prompt_response_schema"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pathDigest"
          },
          "minItems": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "scheduleSample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "replay_order"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "enum": [
            1,
            2
          ]
        },
        "replay_order": {
          "type": "array",
          "items": {
            "enum": [
              "control-r1",
              "control-r2",
              "treatment-r1",
              "treatment-r2"
            ]
          },
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "scheduleBlock": {
      "type": "object",
      "additionalProperties": false,
