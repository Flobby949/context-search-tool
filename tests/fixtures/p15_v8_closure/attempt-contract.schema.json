          "const": 8
        },
        "selection_before_online": {
          "const": true
        },
        "candidate_blind": {
          "const": true
        },
        "query_policy": {
          "const": "source_only_no_target_derived_terms"
        },
        "gold_derivation": {
          "const": "independent_stdlib_ast_direct_from_import_unique_top_level_owner"
        },
        "replacement_allowed": {
          "const": false
        }
      }
    },
    "heldCorpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
