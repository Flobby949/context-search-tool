            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "case_ordinals": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1
        },
        "samples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scheduleSample"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "expanded_count": {
          "type": "integer",
          "minimum": 1
        },
        "expanded_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
